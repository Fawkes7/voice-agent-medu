DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/spagent
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/spagent
JWT_SECRET=your-jwt-secret-change-me

# LLM for all agents (SP / tutor / evaluator / final evaluator): openai | gemini | qwen
# Only the key for the selected provider is required.
LLM_PROVIDER=gemini
# Optional; empty uses the provider default (openai: gpt-4.1, gemini: gemini-2.5-flash, qwen: qwen-max)
LLM_MODEL=
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
DASHSCOPE_API_KEY=your-dashscope-api-key

# Voice (MA consultation): Scribe v2 Realtime STT + Eleven Flash v2.5 TTS
# Students speak Chinese; language_code=zh is passed to both STT and TTS.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_STT_LANGUAGE=zh
# Multilingual premade voices; Flash v2.5 + language_code=zh produces Mandarin.
ELEVENLABS_VOICE_ID_PATIENT=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID_TUTOR=21m00Tcm4TlvDq8ikWAM
